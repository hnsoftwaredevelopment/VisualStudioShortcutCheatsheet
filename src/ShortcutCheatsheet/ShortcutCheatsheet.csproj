  <ItemGroup>
    <!-- Icon: Resources\ShortcutCheatsheet.svg is the source, the PNG files are exports of it. -->
    <Content Include="Resources\Icon-128.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Resources\Icon-256.png">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <!-- Icon-32.png is in the DLL as a WPF resource: the image manifest refers to it with a pack URI. -->
    <Resource Include="Resources\Icon-32.png" />
    <Content Include="ShortcutCheatsheet.imagemanifest">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <Content Include="Options\registration.json">
      <IncludeInVSIX>true</IncludeInVSIX>
    </Content>
    <None Include="Resources\Icon-90.png" />
