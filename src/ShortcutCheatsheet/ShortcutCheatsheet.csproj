  <ItemGroup>
    <!-- LogicalName "VSPackage" is where VS looks for package strings (registration.json, ProvideOptionPage).
         The compiled command table (Menus.ctmenu) is merged into the same resource. -->
    <EmbeddedResource Include="Localization\Strings.resx">
      <LogicalName>VSPackage.resources</LogicalName>
      <MergeWithCTO>true</MergeWithCTO>
    </EmbeddedResource>
    <!-- Translations: satellite assemblies (nl\ShortcutCheatsheet.resources.dll, ...), also named VSPackage. -->
    <EmbeddedResource Include="Localization\Strings.cs.resx"><DependentUpon>Strings.resx</DependentUpon><LogicalName>VSPackage.cs.resources</LogicalName></EmbeddedResource>
