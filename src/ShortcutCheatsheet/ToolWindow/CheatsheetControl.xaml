<UserControl x:Class="ShortcutCheatsheet.ToolWindow.CheatsheetControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformUI="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:vsshell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             Background="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- One key, drawn as a key cap. Two rectangles because a DynamicResource brush has no opacity of its own. -->
        <DataTemplate x:Key="KeyCap">
            <Grid Margin="0,1,3,1" MinWidth="18">
                <Rectangle RadiusX="3" RadiusY="3" Opacity="0.08"
                           Fill="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
                <Rectangle RadiusX="3" RadiusY="3" Opacity="0.45" StrokeThickness="1"
                           Stroke="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}" />
                <TextBlock Text="{Binding}" Margin="5,0,5,1" FontSize="11" HorizontalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- One stroke of a chord: Ctrl K. A comma before every stroke but the first. -->
        <DataTemplate x:Key="Stroke">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Separator" Text="," Margin="0,0,4,0" VerticalAlignment="Bottom" Opacity="0.7" />
                <ItemsControl ItemsSource="{Binding}" ItemTemplate="{StaticResource KeyCap}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                    <Setter TargetName="Separator" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- A small label: the extension, or "yours". -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,0,6,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowBorderBrushKey}}" />
        </Style>

        <DataTemplate x:Key="Row">
            <Grid Margin="0,1" ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="110" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ItemsControl ItemsSource="{Binding Strokes}" ItemTemplate="{StaticResource Stroke}" AlternationCount="100" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Scope}" Margin="8,0,0,0" Opacity="0.6"
                               Visibility="{Binding ShowScope, Converter={StaticResource Visible}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <imaging:CrispImage Width="16" Height="16" Margin="6,0,0,0" Moniker="{x:Static catalog:KnownMonikers.StatusWarning}"
                                        Visibility="{Binding HasConflict, Converter={StaticResource Visible}}" />
                    <Border Style="{StaticResource Badge}" Visibility="{Binding IsCustom, Converter={StaticResource Visible}}">
                        <TextBlock Text="yours" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource Badge}" Visibility="{Binding ShowExtension, Converter={StaticResource Visible}}">
                        <TextBlock Text="{Binding Extension}" FontSize="11" Opacity="0.85" MaxWidth="120" TextTrimming="CharacterEllipsis" />
                    </Border>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <!-- Search on its own line, so it keeps its width in a narrow window. -->
        <Grid DockPanel.Dock="Top" Margin="8,8,8,4">
            <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"
                     MinHeight="22" AutomationProperties.Name="Search"
                     Style="{DynamicResource {x:Static vsshell:VsResourceKeys.TextBoxStyleKey}}" />
            <TextBlock Text="Search by name or keys, such as  ctrl+e,v" Margin="6,0,0,0" VerticalAlignment="Center"
                       IsHitTestVisible="False" Opacity="0.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=Search}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <!-- Grouping, buttons and filters: they wrap to the next line when the window is narrow. -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,0,8,4" Orientation="Horizontal">
            <ComboBox Width="150" Margin="0,0,6,4" ToolTip="Group by" AutomationProperties.Name="Group by"
                      ItemsSource="{Binding Groupings}" DisplayMemberPath="Value" SelectedValuePath="Key"
                      SelectedValue="{Binding Grouping}"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ComboBoxStyleKey}}" />
            <Button Content="Refresh" Padding="8,1" Margin="0,0,6,4" Click="Refresh_Click"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
            <Button Content="Export to JSON..." Padding="8,1" Margin="0,0,14,4" Click="Export_Click"
                    Style="{DynamicResource {x:Static vsshell:VsResourceKeys.ButtonStyleKey}}" />
            <CheckBox Content="Only extensions" IsChecked="{Binding OnlyExtensions}" Margin="0,2,14,4" VerticalAlignment="Center"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
            <CheckBox Content="Only added by you" IsChecked="{Binding OnlyCustom}" Margin="0,2,14,4" VerticalAlignment="Center"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
            <CheckBox Content="Only conflicts" IsChecked="{Binding OnlyConflicts}" Margin="0,2,0,4" VerticalAlignment="Center"
                      Style="{DynamicResource {x:Static vsshell:VsResourceKeys.CheckBoxStyleKey}}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Margin="8,0,8,6" Opacity="0.75" TextWrapping="Wrap" />

        <Grid>
            <ListBox x:Name="List" ItemsSource="{Binding Items}" ItemTemplate="{StaticResource Row}"
                     Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                     Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.CommandBindings>
                    <CommandBinding Command="ApplicationCommands.Copy" Executed="Copy_Executed" />
                </ListBox.CommandBindings>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Command="ApplicationCommands.Copy" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="8,0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.GroupStyle>
                    <!-- Outer level: scope, category or extension, as an expander with a count. -->
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander Margin="4,2,4,0" Foreground="{DynamicResource {x:Static platformUI:EnvironmentColors.ToolWindowTextBrushKey}}"
                                                      IsExpanded="{Binding DataContext.ExpandGroups, RelativeSource={RelativeSource AncestorType=ListBox}, Mode=OneWay}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ItemCount, StringFormat=' ({0})'}" Opacity="0.7" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter Margin="12,0,0,4" />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                    <!-- Inner level: a plain heading. -->
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" Margin="4,6,0,2" Opacity="0.75" FontStyle="Italic" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
            </ListBox>
            <TextBlock Text="Collecting shortcuts..." HorizontalAlignment="Center" VerticalAlignment="Center"
                       Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
        </Grid>
    </DockPanel>
</UserControl>
