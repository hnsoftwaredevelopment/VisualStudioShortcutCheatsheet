<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unit tests for everything that runs without Visual Studio. net48, like the extension. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyVersion>2026.11.16.0</AssemblyVersion>
    <FileVersion>2026.11.16.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <!-- Unlike the extension, the tests need the runtime assemblies of the SDK. -->
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\ShortcutCheatsheet\ShortcutCheatsheet.csproj" />
  </ItemGroup>
</Project>
