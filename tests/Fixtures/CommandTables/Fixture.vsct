<?xml version="1.0" encoding="utf-8"?>
<!-- Test fixture: a command table with known commands and key bindings.
     Compiled with VSCT.exe to Fixture.cto by tools\build-fixtures.ps1; the tests read the .cto. -->
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidFixturePackage">
    <Groups>
      <Group guid="guidFixtureCmdSet" id="grpFixture" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_TOOLS" />
      </Group>
    </Groups>
    <Buttons>
      <Button guid="guidFixtureCmdSet" id="cmdidFirst" priority="0x0100" type="Button">
        <Parent guid="guidFixtureCmdSet" id="grpFixture" />
        <Strings>
          <ButtonText>First Command</ButtonText>
          <CanonicalName>.Tools.FixtureFirst</CanonicalName>
        </Strings>
      </Button>
      <Button guid="guidFixtureCmdSet" id="cmdidSecond" priority="0x0101" type="Button">
        <Parent guid="guidFixtureCmdSet" id="grpFixture" />
        <Strings>
          <ButtonText>Second Command</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidFixtureCmdSet" id="cmdidNoKeys" priority="0x0102" type="Button">
        <Parent guid="guidFixtureCmdSet" id="grpFixture" />
        <Strings>
          <ButtonText>Without Keys</ButtonText>
        </Strings>
      </Button>
      <Button guid="guidFixtureOtherSet" id="cmdidOther" priority="0x0100" type="Button">
        <Parent guid="guidFixtureCmdSet" id="grpFixture" />
        <Strings>
          <ButtonText>Other Set Command</ButtonText>
        </Strings>
      </Button>
    </Buttons>
  </Commands>

  <!-- A command of VS itself, placed in our group: a reference, not a definition. -->
  <CommandPlacements>
    <CommandPlacement guid="guidVSStd97" id="cmdidCut" priority="0x0200">
      <Parent guid="guidFixtureCmdSet" id="grpFixture" />
    </CommandPlacement>
  </CommandPlacements>

  <KeyBindings>
    <!-- Ctrl+Shift+F1, everywhere -->
    <KeyBinding guid="guidFixtureCmdSet" id="cmdidFirst" editor="guidVSStd97" key1="VK_F1" mod1="Control Shift" />
    <!-- Ctrl+K, Ctrl+Q chord, in the text editor -->
    <KeyBinding guid="guidFixtureCmdSet" id="cmdidSecond" editor="guidTextEditor" key1="K" mod1="Control" key2="Q" mod2="Control" />
    <!-- Alt+D, everywhere -->
    <KeyBinding guid="guidFixtureOtherSet" id="cmdidOther" editor="guidVSStd97" key1="D" mod1="Alt" />
    <!-- A key binding for a command of VS itself: Ctrl+Alt+X for Cut -->
    <KeyBinding guid="guidVSStd97" id="cmdidCut" editor="guidVSStd97" key1="X" mod1="Control Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidFixturePackage" value="{11111111-2222-3333-4444-555555555555}" />
    <GuidSymbol name="guidFixtureCmdSet" value="{aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee}">
      <IDSymbol name="grpFixture" value="0x1020" />
      <IDSymbol name="cmdidFirst" value="0x0100" />
      <IDSymbol name="cmdidSecond" value="0x0101" />
      <IDSymbol name="cmdidNoKeys" value="0x0102" />
    </GuidSymbol>
    <GuidSymbol name="guidFixtureOtherSet" value="{12345678-9abc-def0-1234-56789abcdef0}">
      <IDSymbol name="cmdidOther" value="0x0200" />
    </GuidSymbol>
    <GuidSymbol name="guidTextEditor" value="{8B382828-6202-11d1-8870-0000F87579D2}" />
  </Symbols>
</CommandTable>
